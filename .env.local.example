# ----------------------------------------------------------------------------
# SalaryMY environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API).
# ----------------------------------------------------------------------------

# Public Supabase URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public-facing site URL. Used for canonical URLs, sitemap and metadata.
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
